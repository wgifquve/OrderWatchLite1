<Window x:Class="OrderWatchLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrderWatchLite - ABCD加仓系统" Height="500" Width="950">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第一行：品种选择 + 仓位比 + 杠杆 + 总额 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5" HorizontalAlignment="Stretch">
            <Label Content="品种" Width="45" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbSymbol" 
                      Width="120" 
                      VerticalAlignment="Center"
                      IsEditable="True"
                      IsTextSearchEnabled="True"
                      StaysOpenOnEdit="True"
                      SelectionChanged="CmbSymbol_SelectionChanged"/>

            <Label Content="仓位比" Width="55" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Slider x:Name="PositionRatioSlider" 
                    Width="120" 
                    Minimum="0" Maximum="100" 
                    TickFrequency="5" 
                    IsSnapToTickEnabled="True"
                    Value="10"
                    VerticalAlignment="Center"/>
            <Label x:Name="PositionRatioLabel" Content="10%" Width="40" VerticalAlignment="Center" Margin="5,0"/>

            <Label Content="杠杆" Width="40" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Slider x:Name="LeverageSlider" 
                    Width="120" 
                    Minimum="5" Maximum="100" 
                    TickFrequency="5" 
                    IsSnapToTickEnabled="True"
                    Value="20"
                    VerticalAlignment="Center"/>
            <Label x:Name="LeverageLabel" Content="20X" Width="40" VerticalAlignment="Center" Margin="5,0"/>

            <Label Content="→ 总额：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Label x:Name="BaseMarginLabel" Content="100U × 20X = 2000U" Width="180" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- 第二行：快速比例按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <Label Content="快速比例" Width="60" VerticalAlignment="Center"/>
            <ToggleButton x:Name="BtnRatio70" Content="70%" Width="100" Height="35" Margin="5" 
                          Style="{StaticResource {x:Type ToggleButton}}"/>
            <ToggleButton x:Name="BtnRatio50" Content="50%" Width="100" Height="35" Margin="5" 
                          Style="{StaticResource {x:Type ToggleButton}}"/>
            <ToggleButton x:Name="BtnRatio30" Content="30%" Width="100" Height="35" Margin="5" 
                          Style="{StaticResource {x:Type ToggleButton}}"/>
            <ToggleButton x:Name="BtnRatio15" Content="15%" Width="100" Height="35" Margin="5" 
                          Style="{StaticResource {x:Type ToggleButton}}"/>
            <Label Content="（点击切换，互斥）" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- 第三行：实际保证金和仓位价值 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <Label Content="实际保证金：" Width="90" VerticalAlignment="Center"/>
            <Label x:Name="ActualMarginLabel" Content="0 U" Width="80" VerticalAlignment="Center" FontWeight="Bold"/>
            <Label Content="× 杠杆 → 仓位价值：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBox x:Name="txtCalculatedValue" 
                     Text="0" 
                     IsReadOnly="True" 
                     Background="LightYellow" 
                     Width="180" 
                     VerticalAlignment="Center"/>
            <Label Content="U" VerticalAlignment="Center"/>
            <Label Content="当前价：" VerticalAlignment="Center" Margin="20,0,0,0"/>
            <Label x:Name="lblCurrentPrice" Content="0.00" Width="80" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <!-- 第四行：BUY / SELL -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10">
            <Button x:Name="BtnBuy" Content="BUY" Width="120" Height="45" Background="LightGreen" Margin="5" FontWeight="Bold" FontSize="16"/>
            <Button x:Name="BtnSell" Content="SELL" Width="120" Height="45" Background="LightCoral" Margin="5" FontWeight="Bold" FontSize="16"/>
            <Label Content="（模拟下单）" Foreground="Gray" VerticalAlignment="Center" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- 第五行：运行日志 -->
        <ListBox Grid.Row="4" x:Name="lstLog" Margin="0,10" Height="120" />
        <Label Grid.Row="4" Content="日志" VerticalAlignment="Top" Margin="5,5,0,0" Foreground="Gray" FontSize="10"/>

        <!-- 第六行：状态栏 -->
        <StatusBar Grid.Row="5" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="就绪" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>