<Window x:Class="OrderWatchLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrderWatchLite" Height="460" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinHeight="400" MinWidth="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 第一行 ===== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
            <Label Content="品种：" VerticalAlignment="Center" FontWeight="Bold"/>
            <ComboBox x:Name="cmbSymbol" Width="130" VerticalAlignment="Center" Margin="0,0,15,0"
                      IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" FontSize="13"/>
            <Label Content="仓位比：" VerticalAlignment="Center" FontWeight="Bold"/>
            <Slider x:Name="PositionRatioSlider" Minimum="0" Maximum="100" Value="10" Width="140" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <Label x:Name="lblRatioValue" Content="10%" Width="45" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14"/>
            <Label Content="杠杆：" VerticalAlignment="Center" FontWeight="Bold"/>
            <Slider x:Name="LeverageSlider" Minimum="5" Maximum="100" Value="20" Width="120" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
            <Label x:Name="lblLeverageValue" Content="20X" Width="45" VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="Bold" FontSize="14"/>
            <Label Content="总额：" VerticalAlignment="Center" FontWeight="Bold"/>
            <Label x:Name="lblTotalValue" Content="0.00 U" Width="100" VerticalAlignment="Center" Background="LightGray" HorizontalContentAlignment="Right" FontWeight="Bold" FontSize="14" Padding="5,0"/>
        </StackPanel>

        <!-- ===== 第二行：快速比例 + 保本控制 ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="快速比例：" VerticalAlignment="Center" FontWeight="Bold"/>
            <ToggleButton x:Name="BtnRatio70" Content="70%" Width="55" Height="28" Margin="0,0,5,0" FontWeight="Bold"/>
            <ToggleButton x:Name="BtnRatio50" Content="50%" Width="55" Height="28" Margin="0,0,5,0" FontWeight="Bold"/>
            <ToggleButton x:Name="BtnRatio30" Content="30%" Width="55" Height="28" Margin="0,0,5,0" FontWeight="Bold"/>
            <ToggleButton x:Name="BtnRatio15" Content="15%" Width="55" Height="28" Margin="0,0,15,0" FontWeight="Bold"/>
            <Label Content="（未选中=100%）" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,20,0"/>

            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" VerticalAlignment="Center" Margin="5,0"/>
            <Label Content="🛡️ 保本：" VerticalAlignment="Center" FontWeight="Bold"/>
            <ToggleButton x:Name="BtnBreakEven" Content="🔒 关闭" Width="80" Height="28" 
                          Background="#E8E8E8" Margin="0,0,8,0" FontWeight="Bold"
                          Checked="BtnBreakEven_Checked" Unchecked="BtnBreakEven_Unchecked"/>
            <Label Content="NL%" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="TxtBreakEvenPercent" Text="3" Width="40" Height="26" VerticalAlignment="Center" 
                     TextAlignment="Center" Margin="2,0,8,0" FontSize="13" FontWeight="Bold"/>
            <Label x:Name="LblBreakEvenStatus" Content="⏸" VerticalAlignment="Center" 
                   Foreground="Gray" FontWeight="Bold" FontSize="14" Width="25"/>
        </StackPanel>

        <!-- ===== 第三行：保证金 + 仓位价值 + 当前价 ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Label Content="💰 实际保证金：" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtActualMargin" Width="100" Height="28" IsReadOnly="True" Background="LightYellow" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
            <Label Content="📊 仓位价值：" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox x:Name="txtPositionValue" Width="120" Height="28" IsReadOnly="True" Background="LightYellow" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14" FontWeight="Bold" TextAlignment="Right"/>
            <Label Content="📈 当前价：" VerticalAlignment="Center" FontWeight="Bold"/>
            <Label x:Name="lblCurrentPrice" Content="0.00" Width="100" Height="28" VerticalAlignment="Center" Background="LightCyan" HorizontalContentAlignment="Right" FontWeight="Bold" FontSize="16" Padding="5,0"/>
        </StackPanel>

        <!-- ===== 第四行：BUY / SELL + 刷新按钮 ===== -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnBuy" Content="▲ BUY 买入" Width="150" Height="50" 
                    Background="#66BB6A" Foreground="White" FontWeight="Bold" FontSize="17" 
                    Margin="0,0,15,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
            <Button x:Name="BtnSell" Content="▼ SELL 卖出" Width="150" Height="50" 
                    Background="#EF5350" Foreground="White" FontWeight="Bold" FontSize="17" 
                    Margin="0,0,20,0" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>

            <!-- ===== 新增：刷新场内订单按钮 ===== -->
            <Button x:Name="BtnRefreshOrders" Content="🔄 刷新场内订单" Width="130" Height="35"
                    Background="#E3F2FD" Foreground="#0D47A1" FontWeight="Bold" FontSize="13"
                    BorderThickness="1" BorderBrush="#90CAF9" Cursor="Hand"
                    Margin="0,0,20,0" Click="BtnRefreshOrders_Click" ToolTip="从币安同步当前持仓和挂单"/>
            <Label Content="  |  保本监控: 查看状态栏右侧" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
        </StackPanel>

        <!-- ===== 分隔线 ===== -->
        <Separator Grid.Row="4" Margin="0,5,0,5" Background="#CCCCCC"/>

        <!-- ===== 第五行：日志 ===== -->
        <ListBox x:Name="LogListBox" Grid.Row="5" Margin="0,0,0,3" 
                 FontSize="10" Background="#1E1E1E" Foreground="#CCCCCC"
                 BorderBrush="#555" BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MaxHeight="80">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontFamily="Consolas"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== 第六行：状态栏 ===== -->
        <StatusBar Grid.Row="6" Height="24" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="✅ 就绪" FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Center">
                <TextBlock x:Name="StatusBarBreakEven" Text="" Foreground="Gray" FontSize="11" Margin="0,0,15,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="StatusBarMonitorCount" Text="🛡️ 监控: 0 单" Foreground="Gray" FontSize="11" Margin="0,0,15,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="OrderWatchLite v1.6" Foreground="Gray" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>